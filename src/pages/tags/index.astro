---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTags, getPosts } from '../../lib/posts';

const posts = await getPosts();
const tags = collectTags(posts);
---
<BaseLayout
  title="Topics — Browse Every Essay by Tag"
  description="Browse the archive by topic: architecture, performance, engineering, DevOps, career, and writing. Each tag page collects every related essay in one place."
  path="/tags"
>
  <div class="container">
    <header class="page-head">
      <h1>Tags</h1>
      <p class="lede">Six threads, followed across the archive. Every essay belongs to at least one.</p>
    </header>

    <div class="tag-index">
      {tags.map((tag) => (
        <a class="tag-row" href={`/tags/${tag.name}`}>
          <span class="tag-name">{tag.name}</span>
          <span class="tag-count">{String(tag.count).padStart(2, '0')}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
