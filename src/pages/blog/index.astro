---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, groupByYear } from '../../lib/posts';

const posts = await getPosts();
const groups = groupByYear(posts);
---
<BaseLayout
  title="The Archive — Architecture, Performance & Craft"
  description="Every essay in the archive, on architecture, performance, engineering craft, and the lessons that only surface after a system ships — newest first."
  path="/blog"
>
  <div class="container">
    <header class="page-head">
      <h1>Writing</h1>
      <div class="head-row">
        <p class="lede">
          Field notes, mostly about systems that age badly or surprisingly well. Every essay
          contains something I actually built, measured, or got wrong.
        </p>
        <a class="head-link" href="/tags">All tags →</a>
      </div>
    </header>

    {groups.map((group) => (
      <section class="year-group">
        <h2 class="year-label">{group.year}</h2>
        <div class="post-list">
          {group.posts.map((post) => <PostRow post={post} />)}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
