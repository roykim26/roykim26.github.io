---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PostRow from '../components/PostRow.astro';
import Subscribe from '../components/Subscribe.astro';
import { getPosts, readingTime, type Post } from '../lib/posts';
import { absoluteUrl, formatIsoDate, guideForTag } from '../lib/site';

const posts = await getPosts();
const byId = new Map(posts.map((post) => [post.id, post]));
const cluster = (guideForTag('performance')?.posts ?? [])
  .map((id) => byId.get(id))
  .filter((post): post is Post => Boolean(post));
const minutes = cluster.reduce((total, post) => total + readingTime(post), 0);

// pillar 是策展页，本身没有发布日期；用集群内最新一次修改作为新鲜度信号。
const latestUpdate = cluster.reduce<Date | undefined>((newest, post) => {
  const date = post.data.updatedDate ?? post.data.pubDate;
  return !newest || date > newest ? date : newest;
}, undefined);

const title = 'Performance — A Field Guide to Latency & Layout';
const description =
  'A guide to the performance users actually feel: tail latency, layout shift, and the build times that decide how often a team can ship.';

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': absoluteUrl('/performance'),
    url: absoluteUrl('/performance'),
    name: title,
    description,
    inLanguage: 'en',
    ...(latestUpdate ? { dateModified: formatIsoDate(latestUpdate) } : {}),
    about: [
      { '@type': 'Thing', name: 'Web performance' },
      { '@type': 'Thing', name: 'Latency' },
      { '@type': 'Thing', name: 'Core Web Vitals' },
    ],
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: cluster.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: absoluteUrl(`/blog/${post.id}`),
        name: post.data.title,
      })),
    },
  },
];
---
<BaseLayout title={title} description={description} path="/performance" schema={schema}>
  <div class="container">
    <header class="page-head">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Topics', href: '/tags' },
          { label: 'Performance' },
        ]}
      />
      <div class="eyebrow mono" style="margin-top:20px">Topic guide · 02</div>
      <h1>Performance</h1>
      <p class="lede">
        Performance is not a score; it is the delay between a person's intent and the
        system's response. This guide follows three places that delay hides: the tail,
        the layout, and the build.
      </p>
      <div class="head-meta mono">
        <span>{cluster.length} essays</span>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        <span aria-hidden="true">·</span>
        <span>Curated path</span>
      </div>
    </header>

    <section class="section guide-intro" aria-labelledby="guide-argument">
      <div class="section-head">
        <h2 id="guide-argument">The argument</h2>
        <span class="mono">Start here</span>
      </div>
      <ol class="guide-steps">
        <li>
          <span class="step-index mono" aria-hidden="true">01</span>
          <div>
            <h3><a href="/blog/slow-apis">Averages hide the failure</a></h3>
            <p>
              A p50 can look healthy while one tenant waits seconds. Measure the population,
              read the p95, and fix the tail instead of the average.
            </p>
          </div>
        </li>
        <li>
          <span class="step-index mono" aria-hidden="true">02</span>
          <div>
            <h3><a href="/blog/cls-in-practice">Layout shift is a missing reservation</a></h3>
            <p>
              The browser moves content because nobody told it how much space to reserve.
              Make that decision before paint, not after the layout has already shifted.
            </p>
          </div>
        </li>
        <li>
          <span class="step-index mono" aria-hidden="true">03</span>
          <div>
            <h3><a href="/blog/build-pipeline-as-product">Build time is user-facing too</a></h3>
            <p>
              Every minute in CI is a minute the team cannot ship. Treat pipeline latency
              as a product metric, with users, a failure mode, and a budget.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <section class="section" aria-labelledby="guide-essays">
      <div class="section-head">
        <h2 id="guide-essays">All essays in this guide</h2>
        <a href="/tags/performance">Tag archive →</a>
      </div>
      <div class="post-list">
        {cluster.map((post) => <PostRow post={post} />)}
      </div>
    </section>

    <section class="section guide-next" aria-labelledby="next-guide">
      <div class="section-head">
        <h2 id="next-guide">Continue with Architecture</h2>
        <a href="/architecture">Open guide →</a>
      </div>
      <p>
        Performance work eventually runs into architecture: the boundary that forces an
        extra round trip, the dependency that cannot be cached, the abstraction that hides
        a query. The Architecture guide starts where those decisions are made.
      </p>
    </section>
  </div>

  <div class="container" style="margin-top:24px">
    <Subscribe
      eyebrow="Keep the thread"
      heading="One essay, every other Tuesday."
      body="New field notes on architecture and performance, written for working engineers. No link roundups, no tracking."
    />
  </div>
</BaseLayout>

<style>
  .guide-intro {
    border-top: 0;
  }

  .guide-steps {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .guide-steps li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--rule);
  }

  .step-index {
    color: var(--accent);
    padding-top: 6px;
  }

  .guide-steps h3 {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 6px;
  }

  .guide-steps h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .guide-steps h3 a:hover {
    color: var(--accent);
  }

  .guide-steps p,
  .guide-next p {
    max-width: 62ch;
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .guide-steps li {
      grid-template-columns: 32px minmax(0, 1fr);
      gap: 12px;
    }
  }
</style>
