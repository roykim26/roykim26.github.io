---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import Subscribe from '../components/Subscribe.astro';
import { getPosts } from '../lib/posts';
import { site } from '../lib/site';

const posts = await getPosts();
const latest = posts.slice(0, 8);
---
<BaseLayout path="/">
  <div class="container">
    <section class="home-intro" aria-labelledby="hero-title">
      <h1 id="hero-title">{site.author.name}<span class="dot">.</span></h1>
      <p class="home-lead">
        I'm a software engineer building backend systems. I write about the decisions that
        only reveal their cost years later, and the quiet ones that hold everything together.
      </p>
    </section>

    <section class="home-list" aria-labelledby="latest-title">
      <h2 id="latest-title" class="sr-only">Latest writing</h2>
      <div class="post-list">
        {latest.map((post) => <PostRow post={post} />)}
      </div>
      <p class="home-more"><a href="/blog">All writing →</a></p>
    </section>
  </div>

  <Subscribe />
</BaseLayout>
