---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PostRow from '../components/PostRow.astro';
import Subscribe from '../components/Subscribe.astro';
import { getPosts, readingTime, type Post } from '../lib/posts';
import { absoluteUrl, formatIsoDate, guideForTag } from '../lib/site';

const posts = await getPosts();
const byId = new Map(posts.map((post) => [post.id, post]));
const cluster = (guideForTag('architecture')?.posts ?? [])
  .map((id) => byId.get(id))
  .filter((post): post is Post => Boolean(post));
const minutes = cluster.reduce((total, post) => total + readingTime(post), 0);

// pillar 是策展页，本身没有发布日期；用集群内最新一次修改作为新鲜度信号。
const latestUpdate = cluster.reduce<Date | undefined>((newest, post) => {
  const date = post.data.updatedDate ?? post.data.pubDate;
  return !newest || date > newest ? date : newest;
}, undefined);

const title = 'Architecture — A Field Guide to Systems That Last';
const description =
  'A guide to the decisions that shape a system for years: where boundaries go, what abstractions cost, and when a rewrite is the wrong move.';

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': absoluteUrl('/architecture'),
    url: absoluteUrl('/architecture'),
    name: title,
    description,
    inLanguage: 'en',
    ...(latestUpdate ? { dateModified: formatIsoDate(latestUpdate) } : {}),
    about: [
      { '@type': 'Thing', name: 'Software architecture' },
      { '@type': 'Thing', name: 'System design' },
      { '@type': 'Thing', name: 'Software migration' },
    ],
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: cluster.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: absoluteUrl(`/blog/${post.id}`),
        name: post.data.title,
      })),
    },
  },
];
---
<BaseLayout title={title} description={description} path="/architecture" schema={schema}>
  <div class="container">
    <header class="page-head">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Topics', href: '/tags' },
          { label: 'Architecture' },
        ]}
      />
      <div class="eyebrow mono" style="margin-top:20px">Topic guide · 01</div>
      <h1>Architecture</h1>
      <p class="lede">
        Systems are shaped less by their diagrams than by the decisions nobody revisits.
        This guide follows three of them: what to keep boring, what convenience really costs,
        and how to replace a monolith without betting the company.
      </p>
      <div class="head-meta mono">
        <span>{cluster.length} essays</span>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        <span aria-hidden="true">·</span>
        <span>Curated path</span>
      </div>
    </header>

    <section class="section guide-intro" aria-labelledby="guide-argument">
      <div class="section-head">
        <h2 id="guide-argument">The argument</h2>
        <span class="mono">Start here</span>
      </div>
      <ol class="guide-steps">
        <li>
          <span class="step-index mono" aria-hidden="true">01</span>
          <div>
            <h3><a href="/blog/boring-architecture">Boring is a budget</a></h3>
            <p>
              Novelty is finite. Spend it where it changes the product, and make the rest
              unremarkable enough that nobody has to think about it.
            </p>
          </div>
        </li>
        <li>
          <span class="step-index mono" aria-hidden="true">02</span>
          <div>
            <h3><a href="/blog/cost-of-convenience">Convenience is a loan</a></h3>
            <p>
              Every abstraction borrows against future understanding. The interest comes due
              when the abstraction leaks, and someone has to own a dependency they never chose.
            </p>
          </div>
        </li>
        <li>
          <span class="step-index mono" aria-hidden="true">03</span>
          <div>
            <h3><a href="/blog/rewriting-the-monolith">A rewrite is a bet; a seam is a hedge</a></h3>
            <p>
              You rarely understand the old system better than its builders. Strangle it one
              route at a time, with a clean seam and a rehearsed rollback.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <section class="section" aria-labelledby="guide-essays">
      <div class="section-head">
        <h2 id="guide-essays">All essays in this guide</h2>
        <a href="/tags/architecture">Tag archive →</a>
      </div>
      <div class="post-list">
        {cluster.map((post) => <PostRow post={post} />)}
      </div>
    </section>

    <section class="section guide-next" aria-labelledby="next-guide">
      <div class="section-head">
        <h2 id="next-guide">Continue with Performance</h2>
        <a href="/performance">Open guide →</a>
      </div>
      <p>
        Architecture decides what the system costs to change. Performance decides what it
        costs to use. The Performance guide follows the same method: measure the population,
        fix the tail, and reserve space before the browser has to guess.
      </p>
    </section>
  </div>

  <div class="container" style="margin-top:24px">
    <Subscribe
      eyebrow="Keep the thread"
      heading="One essay, every other Tuesday."
      body="New field notes on architecture and performance, written for working engineers. No link roundups, no tracking."
    />
  </div>
</BaseLayout>

<style>
  .guide-intro {
    border-top: 0;
  }

  .guide-steps {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .guide-steps li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--rule);
  }

  .step-index {
    color: var(--accent);
    padding-top: 6px;
  }

  .guide-steps h3 {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 6px;
  }

  .guide-steps h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .guide-steps h3 a:hover {
    color: var(--accent);
  }

  .guide-steps p,
  .guide-next p {
    max-width: 62ch;
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .guide-steps li {
      grid-template-columns: 32px minmax(0, 1fr);
      gap: 12px;
    }
  }
</style>
