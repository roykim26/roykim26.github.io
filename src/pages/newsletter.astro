---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';

const endpoint = site.newsletter.endpoint;
---
<BaseLayout
  title="The Newsletter — One Essay Every Other Tuesday"
  description="A letter every other Tuesday: one long-form essay on building software, delivered in full. No link roundups, no sponsors, no tracking pixels."
  path="/newsletter"
>
  <div class="container">
    <header class="page-head">
      <h1>Newsletter</h1>
      <p class="lede">
        One essay, every other Tuesday. No tracking pixels, no resale, one-click unsubscribe.
      </p>
    </header>

    <div class="newsletter-body">
      {endpoint ? (
        <form class="newsletter-form" action={endpoint} method="post" target="_blank" rel="noopener noreferrer">
          <div class="field">
            <label for="newsletter-email">Email address</label>
            <input
              id="newsletter-email"
              type="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
          </div>
          <button class="btn" type="submit">Subscribe</button>
        </form>
      ) : (
        <p>
          Email signup is not open yet. Write to
          <a href={`mailto:${site.author.email}?subject=${encodeURIComponent('Subscribe me to the newsletter')}`}>{site.author.email}</a>
          and I will add you by hand.
        </p>
      )}

      <p class="newsletter-note">
        Prefer a feed? <a href="/rss.xml">RSS</a> carries the same text.
      </p>
    </div>
  </div>
</BaseLayout>
