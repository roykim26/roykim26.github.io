---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Not found"
  description="That page is not here. Browse the writing, tags, or head home."
  path="/404"
  robots="noindex, follow"
  canonical={false}
>
  <div class="container">
    <section class="page-404">
      <p class="code-label">404</p>
      <h1>Page not found.</h1>
      <p>That link does not point to anything here. It may have been an old URL, or a typo.</p>
      <p class="notfound-links">
        <a href="/blog">All writing →</a>
        <a href="/">Home →</a>
      </p>
    </section>
  </div>
</BaseLayout>
