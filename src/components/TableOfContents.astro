---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  variant: 'desktop' | 'mobile';
}

const { headings, variant } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
{
  variant === 'desktop' ? (
    <nav class="toc-desktop" aria-label="Table of contents">
      <p class="toc-label mono">Contents</p>
      <ul class="toc-list">
        {items.map((heading) => (
          <li class={`depth-${heading.depth}`}>
            <a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  ) : (
    <details class="toc-mobile">
      <summary class="mono">Contents</summary>
      <ul class="toc-list">
        {items.map((heading) => (
          <li class={`depth-${heading.depth}`}>
            <a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const headings = Array.from(document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]'));
  if (links.length > 0 && headings.length > 0) {
    let frame = 0;
    const update = (): void => {
      frame = 0;
      let current = headings[0]?.id ?? '';
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= 120) current = heading.id;
      }
      links.forEach((link) => {
        link.classList.toggle('is-active', link.hash === `#${current}`);
      });
    };
    const onScroll = (): void => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }
</script>
