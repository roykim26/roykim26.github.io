---
import { site, absoluteUrl } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  schema?: Record<string, unknown>[];
  robots?: string;
  canonical?: boolean;
}

const {
  title = site.title,
  description = site.description,
  path = Astro.url.pathname,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  schema = [],
  robots = 'index, follow, max-image-preview:large',
  canonical: includeCanonical = true,
} = Astro.props;

const pageTitle = title === site.title ? title : `${title} · ${site.name}`;
const canonical = absoluteUrl(path);
const imageUrl = absoluteUrl(image);

const personId = `${site.url}/about#person`;
const sameAs: string[] = [
  site.author.github,
  site.author.x,
  site.author.linkedin,
].filter((url) => url.length > 0);

const baseSchema = [
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    name: site.name,
    url: site.url,
    description: site.description,
    inLanguage: 'en',
    publisher: { '@id': personId },
  },
  {
    '@type': 'Person',
    '@id': personId,
    name: site.author.name,
    url: absoluteUrl('/about'),
    description: site.author.bio,
    jobTitle: site.author.role,
    email: `mailto:${site.author.email}`,
    knowsAbout: [
      'Software architecture',
      'Web performance',
      'TypeScript',
      'DevOps',
      'Technical writing',
    ],
    ...(sameAs.length > 0 ? { sameAs } : {}),
  },
];
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
{includeCanonical && <link rel="canonical" href={canonical} />}
<meta name="generator" content={Astro.generator} />
<meta name="robots" content={robots} />
<meta name="theme-color" content="#F6F2E9" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={`${site.name} — Essays`} href="/rss.xml" />

<link
  rel="preload"
  href="/fonts/instrument-serif-400.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${pageTitle} — social card`} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={`${pageTitle} — social card`} />

<script
  type="application/ld+json"
  set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': [...baseSchema, ...schema] })}
/>

<script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem('jl-theme');
      var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    } catch (e) {
      document.documentElement.dataset.theme = 'light';
    }
  })();
</script>
