---
import { site, absoluteUrl } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  schema?: Record<string, unknown>[];
  robots?: string;
  canonical?: boolean;
}

const {
  title = site.title,
  description = site.description,
  path = Astro.url.pathname,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  schema = [],
  robots = 'index, follow, max-image-preview:large',
  canonical: includeCanonical = true,
} = Astro.props;

const pageTitle = title === site.title ? title : `${title} · ${site.name}`;
const canonical = absoluteUrl(path);
const imageUrl = absoluteUrl(image);

const orgId = `${site.url}/about#organization`;
const sameAs: string[] = [
  site.author.github,
  site.author.x,
  site.author.linkedin,
].filter((url) => url.length > 0);

// 结构化数据经 set:html 原样注入 <script>，JSON.stringify 不转义 </script>。
// 这里把 JSON 中可能提前闭合标签的字符转成等价的 \u 转义，防止 frontmatter 里的
// 标题/描述带出标签时把数据块变成可执行脚本。
const escapeJsonForHtml = (value: unknown): string =>
  JSON.stringify(value)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026')
    .replace(/\u2028/g, '\\u2028')
    .replace(/\u2029/g, '\\u2029');

// 线上托管（GitHub Pages）不支持自定义响应头，_headers / nginx 里的 CSP 不会生效。
// 因此这里用 meta 兜底：meta 不支持 frame-ancestors / report-uri / sandbox，
// 所以单独给一份不含这些指令的策略，避免浏览器在控制台报“指令被忽略”。
// 与 public/_headers、nginx.conf、netlify.toml、vercel.json 中的策略保持一致。
const contentSecurityPolicy =
  "default-src 'self'; object-src 'none'; base-uri 'self'; " +
  "script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; " +
  "img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' https:";

const baseSchema = [
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    name: site.name,
    url: site.url,
    description: site.description,
    inLanguage: 'en',
    publisher: { '@id': orgId },
  },
  {
    '@type': 'Organization',
    '@id': orgId,
    name: site.author.name,
    url: absoluteUrl('/about'),
    description: site.author.bio,
    email: `mailto:${site.author.email}`,
    logo: {
      '@type': 'ImageObject',
      url: absoluteUrl('/icon-512.png'),
      width: 512,
      height: 512,
    },
    knowsAbout: [
      'Software architecture',
      'Web performance',
      'TypeScript',
      'DevOps',
      'Technical writing',
    ],
    ...(sameAs.length > 0 ? { sameAs } : {}),
  },
];
---
<meta charset="UTF-8" />
<meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
{includeCanonical && <link rel="canonical" href={canonical} />}
<meta name="generator" content={Astro.generator} />
<meta name="robots" content={robots} />
<meta name="google-site-verification" content="mjQzxAk0GDfhLCUUYEKLQ7P16nqumdcdvlUl7jXrQ6k" />
<meta name="theme-color" content="#FBFAF7" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" type="application/rss+xml" title={`${site.name} — Essays`} href="/rss.xml" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${pageTitle} — social card`} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={`${pageTitle} — social card`} />

<script
  type="application/ld+json"
  set:html={escapeJsonForHtml({ '@context': 'https://schema.org', '@graph': [...baseSchema, ...schema] })}
/>

<script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem('ws-theme');
      var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    } catch (e) {
      document.documentElement.dataset.theme = 'light';
    }
  })();
</script>
