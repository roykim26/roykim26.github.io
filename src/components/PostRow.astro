---
import type { Post } from '../lib/posts';
import { readingTime } from '../lib/posts';
import { formatDate } from '../lib/site';

interface Props {
  post: Post;
  number?: string;
  compact?: boolean;
  showDescription?: boolean;
}

const { post, number, compact = false, showDescription = true } = Astro.props;
const minutes = readingTime(post);
---
<a
  class:list={['post-row', { 'is-compact': compact }]}
  href={`/blog/${post.id}`}
  data-post-row
  data-tags={post.data.tags.join(' ')}
>
  <span class="row-date mono">{number ?? formatDate(post.data.pubDate)}</span>
  <span class="row-body">
    <span class="row-title">{post.data.title}</span>
    {showDescription && <span class="row-desc">{post.data.description}</span>}
    <span class="row-tags mono">{post.data.tags.join(' · ')}</span>
  </span>
  <span class="row-meta mono">
    <span>{minutes} min</span>
    <span class="row-arrow" aria-hidden="true">↗</span>
  </span>
</a>
