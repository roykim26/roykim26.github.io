---
import type { Post } from '../lib/posts';
import { formatDate } from '../lib/site';

interface Props {
  post: Post;
  showDescription?: boolean;
}

const { post, showDescription = true } = Astro.props;
---
<a class="post-row" href={`/blog/${post.id}`}>
  <time class="row-date" datetime={post.data.pubDate.toISOString()}>
    {formatDate(post.data.pubDate)}
  </time>
  <span class="row-body">
    <span class="row-title">{post.data.title}</span>
    {showDescription && <span class="row-desc">{post.data.description}</span>}
  </span>
</a>
